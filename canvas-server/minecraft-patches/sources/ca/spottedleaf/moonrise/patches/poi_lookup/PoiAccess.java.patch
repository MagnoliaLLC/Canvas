+    private static long[] squaredGaps(final int source, final int lowerSection, final int length) {
+        final long[] gaps = new long[length];
+
+        for (int i = 0; i < length; ++i) {
+            final int min = (lowerSection + i) << 4;
+            final int max = min | 15;
+            final long gap = source < min ? (long)min - source : (source > max ? (long)source - max : 0L);
+
+            gaps[i] = gap * gap;
+        }
+
+        return gaps;
+    }
