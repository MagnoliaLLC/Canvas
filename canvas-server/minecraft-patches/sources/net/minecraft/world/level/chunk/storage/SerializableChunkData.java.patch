+    private static @Nullable BlockState readBlockState(final net.minecraft.nbt.Tag entry) {
+        if (entry instanceof net.minecraft.nbt.StringTag(String name)) {
+            final Block block = readBlock(name);
+            return block == null ? null : block.defaultBlockState();
+        }
+        if (!(entry instanceof CompoundTag compound) || !(compound.get("id") instanceof net.minecraft.nbt.StringTag(String name))) {
+            return null;
+        }
+        final Block block = readBlock(name);
+        if (block == null) {
+            return null;
+        }
+        BlockState state = block.defaultBlockState();
+        if (block.getStateDefinition().isSingletonState() || !(compound.get("properties") instanceof CompoundTag properties)) {
+            return state;
+        }
+        for (final net.minecraft.world.level.block.state.properties.Property<?> property : block.getStateDefinition().getProperties()) {
+            final net.minecraft.nbt.Tag value = properties.get(property.getName());
+            if (value == null) {
+                continue;
+            }
+            if (!(value instanceof net.minecraft.nbt.StringTag(String string))) {
+                return null;
+            }
+            state = withValue(state, property, string);
+        }
+        return state;
+    }
