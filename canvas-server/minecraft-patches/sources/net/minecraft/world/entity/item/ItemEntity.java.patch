+    // every block the item is in or lies on, with the one under each for a fence or wall it lies on; none when one is not
+    // loaded or a block around them has a shape its block entity moves with no block write, as a shulker box lid does
+    private net.minecraft.world.level.block.state.BlockState @Nullable [] canvas$readRestBlocks() {
+        final net.minecraft.world.phys.AABB box = this.getBoundingBox();
+        final int minX = Mth.floor(box.minX);
+        final int maxX = Mth.floor(box.maxX);
+        final int minY = Mth.floor(box.minY - 1.0E-6) - 1;
+        final int maxY = Mth.floor(box.maxY);
+        final int minZ = Mth.floor(box.minZ);
+        final int maxZ = Mth.floor(box.maxZ);
+        final net.minecraft.world.level.block.state.BlockState[] states = new net.minecraft.world.level.block.state.BlockState[(maxX - minX + 1) * (maxY - minY + 1) * (maxZ - minZ + 1)];
+        final BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+        int index = 0;
+        for (int x = minX - 1; x <= maxX + 1; ++x) {
+            for (int z = minZ - 1; z <= maxZ + 1; ++z) {
+                final boolean inBox = x >= minX && x <= maxX && z >= minZ && z <= maxZ;
+                for (int y = minY; y <= maxY; ++y) {
+                    final net.minecraft.world.level.block.state.BlockState state = this.level().getBlockStateIfLoaded(pos.set(x, y, z));
+                    if (state == null || state.hasBlockEntity() && state.getBlock().hasDynamicShape()) {
+                        return null;
+                    }
+                    if (inBox) {
+                        states[index++] = state;
+                    }
+                }
+            }
+        }
+        return states;
+    }
