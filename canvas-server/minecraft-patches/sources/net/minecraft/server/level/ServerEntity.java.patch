+    // Canvas start - skip movement packets that change nothing on the client
+    /**
+     * Whether every viewer already holds what this packet would tell it, so sending it changes nothing they
+     * draw. Only entities the client never moves by itself qualify (it simulates none of them unless it
+     * controls them, and then ignores position packets), only once its last change of target has had time
+     * to finish interpolating, and never for a new viewer, a dismount or a precise-position request: then
+     * it is the hard colliders' every-update full sync repeating the last one bit for bit, or the
+     * periodic position heartbeat carrying no change. Records what was sent otherwise.
+     */
+    private boolean canvas$changesNothing(final MovementPacket<ClientGamePacketListener> packet) {
+        final boolean unchanged = switch (packet) {
+            case ClientboundEntityPositionSyncPacket sync -> sync.equals(this.canvas$lastSync);
+            case ClientboundMoveEntityPacket.Pos pos -> VecDelta.ZERO.equals(pos.getPositionDelta());
+            default -> false;
+        };
+        final boolean skip = unchanged
+            && this.canvas$settledUpdates >= CANVAS_SETTLED_UPDATES
+            && !this.forceStateResync
+            && !this.wasRiding
+            && !this.entity.getRequiresPrecisePosition()
+            && this.entity.getMoveSimulationType() == net.minecraft.world.entity.MoveSimulationType.AUTHORITATIVE_SIDE;
+
+        if (!skip) {
+            if (!unchanged) {
+                this.canvas$settledUpdates = 0;
+            }
+            this.canvas$lastSync = packet instanceof ClientboundEntityPositionSyncPacket sync ? sync : null;
+        }
+        return skip;
+    }
+
+    private void canvas$moved() {
+        this.canvas$lastSync = null;
+        this.canvas$settledUpdates = 0;
+    }
+    // Canvas end - skip movement packets that change nothing on the client
 
