+package io.canvasmc.canvas.world.inventory;
+
+/**
+ * Holds item stacks and is told whenever one of them changes its count, item or components, so that a check over
+ * what it holds can be skipped while nothing changed.
+ */
+public interface StackHolder {
+
+    /**
+     * Called before a held stack changes its count, item or components.
+     */
+    void canvas$stackChanged();
+}
