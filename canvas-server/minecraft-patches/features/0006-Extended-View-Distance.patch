diff --git a/io/canvasmc/canvas/extendedview/ExtendedViewDistance.java b/io/canvasmc/canvas/extendedview/ExtendedViewDistance.java
new file mode 100644
index 0000000000000000000000000000000000000000..323e172026c6fa0845a09933d54df059f692d9fe
--- /dev/null
+++ b/io/canvasmc/canvas/extendedview/ExtendedViewDistance.java
@@ -0,0 +1,191 @@
+package io.canvasmc.canvas.extendedview;
+
+import ca.spottedleaf.concurrentutil.util.Priority;
+import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
+import ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO;
+import com.mojang.logging.LogUtils;
+import io.canvasmc.canvas.GlobalConfiguration;
+import io.canvasmc.canvas.util.Util;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
+import net.minecraft.SharedConstants;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtUtils;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket;
+import net.minecraft.network.protocol.game.ClientboundLightUpdatePacketData;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.chunk.PalettedContainerFactory;
+import net.minecraft.world.level.chunk.UpgradeData;
+import net.minecraft.world.level.chunk.status.ChunkStatus;
+import net.minecraft.world.level.chunk.storage.SerializableChunkData;
+import net.minecraft.world.ticks.LevelChunkTicks;
+import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
+
+public final class ExtendedViewDistance {
+
+    public static final Logger LOGGER = LogUtils.getLogger();
+
+    // our own threads, the worker pool would only reach these once nothing else loads
+    private static final Executor PACKET_BUILD_EXECUTOR = Executors.newFixedThreadPool(
+        Math.max(1, Runtime.getRuntime().availableProcessors() / 4),
+        Thread.ofPlatform().name("Canvas Visual View Builder #", 0).daemon().priority(Thread.NORM_PRIORITY - 1).factory()
+    );
+
+    public final VVChunkCache cache = new VVChunkCache();
+
+    private final ServerLevel world;
+    private final LevelChunkSection airSection;
+
+    public ExtendedViewDistance(final ServerLevel world) {
+        this.world = world;
+
+        final PalettedContainerFactory factory = PalettedContainerFactory.create(this.world.registryAccess());
+        this.airSection = new LevelChunkSection(factory.createForBlockStates(), factory.createForBiomes());
+    }
+
+    public CompletableFuture<Result> tryLoad(final int chunkX, final int chunkZ) {
+        return this.cache.computeIfAbsent(
+            CoordinateUtils.getChunkKey(chunkX, chunkZ),
+            (_) -> this.startBuild(chunkX, chunkZ)
+        );
+    }
+
+    private CompletableFuture<Result> startBuild(final int chunkX, final int chunkZ) {
+        final CompletableFuture<Result> future = new CompletableFuture<>();
+
+        try {
+            // load the chunk data ONLY
+            MoonriseRegionFileIO.loadDataAsync(
+                this.world,
+                chunkX,
+                chunkZ,
+                MoonriseRegionFileIO.RegionFileType.CHUNK_DATA,
+                (tag, throwable) -> PACKET_BUILD_EXECUTOR.execute(
+                    () -> this.completeBuild(chunkX, chunkZ, future, tag, throwable)
+                ),
+                false,
+                Priority.IDLE // use idle, i dont give a fuck about this
+            );
+        } catch (final Throwable thrown) {
+            // ruh roh :(
+            future.complete(new Result.Failure(thrown));
+        }
+
+        return future;
+    }
+
+    private void completeBuild(
+        final int chunkX,
+        final int chunkZ,
+        final CompletableFuture<Result> future,
+        @Nullable
+        final CompoundTag tag,
+        @Nullable
+        final Throwable ioThrowable
+    ) {
+        if (ioThrowable != null) {
+            // failed, cached for a while so it isn't read every tick
+            future.complete(new Result.Failure(ioThrowable));
+            return;
+        }
+
+        try {
+            // a chunk from a newer version stops the server when parsed
+            if (tag != null && NbtUtils.getDataVersion(tag) <= SharedConstants.getCurrentVersion().dataVersion().version()) {
+                final CompoundTag upgraded = this.world.getChunkSource().chunkMap.upgradeChunkTag(tag);
+
+                // parse the tag and then try and create the packet
+                final SerializableChunkData data = SerializableChunkData.parse(
+                    this.world,
+                    this.world.palettedContainerFactory(),
+                    upgraded
+                );
+
+                //noinspection ConstantValue - the data is nullable, stfu IntelliJ
+                if (
+                    data != null &&
+                    data.chunkStatus().isOrAfter(ChunkStatus.FULL) &&
+                    data.chunkPos().equals(new ChunkPos(chunkX, chunkZ))
+                ) {
+                    final Result.Success result = this.buildRealChunkPacket(chunkX, chunkZ, data);
+
+                    // set "ready" bc of antixray
+                    result.packet().setReady(true);
+                    future.complete(result);
+                    return;
+                }
+            }
+
+            // not generated or something
+            future.complete(Result.NotGenerated.INSTANCE);
+        } catch (final Throwable thrown) {
+            LOGGER.warn(
+                "Failed to build VV chunk at ({}, {}) in '{}', treating it as ungenerated",
+                chunkX,
+                chunkZ,
+                Util.getLevelName(this.world),
+                thrown
+            );
+
+            future.complete(new Result.Failure(thrown));
+        }
+    }
+
+    private Result.Success buildRealChunkPacket(
+        final int chunkX,
+        final int chunkZ,
+        final SerializableChunkData data
+    ) {
+        final int sectionCount = this.world.getSectionsCount();
+        final int minSectionY = this.world.getMinSectionY();
+
+        @Nullable
+        final LevelChunkSection[] sections = new LevelChunkSection[sectionCount];
+
+        // truncate and read sections
+        for (final SerializableChunkData.SectionData sectionData : data.sectionData()) {
+            final int index = sectionData.y() - minSectionY;
+            if (index >= 0 && index < sectionCount && sectionData.chunkSection() != null) {
+                sections[index] = sectionData.chunkSection();
+            }
+        }
+
+        // replace "null" sections with air
+        for (int index = 0; index < sectionCount; ++index) {
+            // this makes "sections" nonnull - required
+            if (sections[index] == null) {
+                sections[index] = this.airSection;
+            }
+        }
+
+        // hollow the chunk and remove the ores if asked of us, before we create the actual chunk object
+        final boolean hollow = GlobalConfiguration.getInstance().chunkSystem.visualViewDistance.hollowChunks;
+        final boolean hideOres = GlobalConfiguration.getInstance().chunkSystem.visualViewDistance.hideOres;
+        if (hollow || hideOres) {
+            //noinspection NullableProblems - we made "sections" nonnull above
+            PacketConstructorUtils.shapeSections(sections, hollow, hideOres);
+        }
+
+        //noinspection NullableProblems - we made "sections" nonnull above
+        final LevelChunk chunk = new LevelChunk(
+            this.world, new ChunkPos(chunkX, chunkZ), UpgradeData.EMPTY,
+            new LevelChunkTicks<>(), new LevelChunkTicks<>(), 0L, sections, null, null
+        );
+
+        // construct and return the finished packet
+        //noinspection DataFlowIssue - chunkPacketInfo can be null, Paper didnt add that annotation
+        final ClientboundLevelChunkPacketData chunkData = new ClientboundLevelChunkPacketData(chunk, null);
+        final ClientboundLightUpdatePacketData lightData = PacketConstructorUtils.createLightData(
+            data,
+            this.world
+        );
+
+        return new Result.Success(new ClientboundLevelChunkWithLightPacket(chunkX, chunkZ, chunkData, lightData));
+    }
+}
diff --git a/io/canvasmc/canvas/extendedview/PacketConstructorUtils.java b/io/canvasmc/canvas/extendedview/PacketConstructorUtils.java
new file mode 100644
index 0000000000000000000000000000000000000000..5e3ff46088b73054366eb53e2ea44b71c9f5546e
--- /dev/null
+++ b/io/canvasmc/canvas/extendedview/PacketConstructorUtils.java
@@ -0,0 +1,382 @@
+package io.canvasmc.canvas.extendedview;
+
+import ca.spottedleaf.moonrise.patches.starlight.light.SWMRNibbleArray;
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
+import java.util.BitSet;
+import java.util.function.Predicate;
+import net.minecraft.network.protocol.game.ClientboundLightUpdatePacketData;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.DataLayer;
+import net.minecraft.world.level.chunk.GlobalPalette;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.chunk.Palette;
+import net.minecraft.world.level.chunk.PalettedContainer;
+import net.minecraft.world.level.chunk.storage.SerializableChunkData;
+import net.minecraft.world.level.lighting.LevelLightEngine;
+import org.jspecify.annotations.Nullable;
+
+public class PacketConstructorUtils {
+
+    public static final int MASK_SIZE = 4096; // 16^3
+    private static final int MASK_LONGS = MASK_SIZE >>> 6;
+    private static final int INNER_ROW = 0x7FFE; // x 1 to 14
+    // one per builder thread, unpacking overwrites all of it
+    private static final ThreadLocal<int[][]> ID_SCRATCH = new ThreadLocal<>();
+
+    private static final Predicate<BlockState> IS_ORE = (state) ->
+        state.is(BlockTags.COPPER_ORES)
+        || state.is(BlockTags.IRON_ORES)
+        || state.is(BlockTags.GOLD_ORES)
+        || state.is(Blocks.COAL_ORE)
+        || state.is(Blocks.DEEPSLATE_COAL_ORE)
+        || state.is(Blocks.LAPIS_ORE)
+        || state.is(Blocks.DEEPSLATE_LAPIS_ORE)
+        || state.is(Blocks.REDSTONE_ORE)
+        || state.is(Blocks.DEEPSLATE_REDSTONE_ORE)
+        || state.is(Blocks.DIAMOND_ORE)
+        || state.is(Blocks.DEEPSLATE_DIAMOND_ORE)
+        || state.is(Blocks.EMERALD_ORE)
+        || state.is(Blocks.DEEPSLATE_EMERALD_ORE);
+
+    private static final Predicate<BlockState> IS_DEEPSLATE_ORE = (state) ->
+        state.is(Blocks.DEEPSLATE_COPPER_ORE)
+        || state.is(Blocks.DEEPSLATE_IRON_ORE)
+        || state.is(Blocks.DEEPSLATE_GOLD_ORE)
+        || state.is(Blocks.DEEPSLATE_COAL_ORE)
+        || state.is(Blocks.DEEPSLATE_LAPIS_ORE)
+        || state.is(Blocks.DEEPSLATE_REDSTONE_ORE)
+        || state.is(Blocks.DEEPSLATE_DIAMOND_ORE)
+        || state.is(Blocks.DEEPSLATE_EMERALD_ORE);
+
+    public static void shapeSections(final LevelChunkSection[] sections, final boolean hollow, final boolean hideOres) {
+        final int sectionCount = sections.length;
+        final int[] @Nullable [] ids = new int[sectionCount][];
+        int[][] scratch = ID_SCRATCH.get();
+        if (scratch == null || scratch.length < sectionCount) {
+            scratch = new int[sectionCount][MASK_SIZE];
+            ID_SCRATCH.set(scratch);
+        }
+        final long[] @Nullable [] seeThrough = new long[sectionCount][];
+
+        // read every section before changing any, since hollowing one looks into its neighbors
+        for (int index = 0; index < sectionCount; ++index) {
+            final LevelChunkSection section = sections[index];
+            if (section.hasOnlyAir()) {
+                continue;
+            }
+
+            final PalettedContainer.Data<BlockState> data = section.getStates().data;
+            final int[] sectionIds = scratch[index];
+            data.storage().unpack(sectionIds);
+            ids[index] = sectionIds;
+
+            if (hollow) {
+                seeThrough[index] = seeThroughMask(data.palette(), sectionIds);
+            }
+        }
+
+        for (int index = 0; index < sectionCount; ++index) {
+            final int[] sectionIds = ids[index];
+            if (sectionIds == null) {
+                continue;
+            }
+
+            final long[] carved = hollow ? carve(seeThrough, index) : null;
+            final OreReplacements ores = hideOres ? new OreReplacements(sections[index].getStates().data.palette()) : null;
+            if (carved == null && (ores == null || !ores.any)) {
+                continue;
+            }
+
+            final LevelChunkSection section = sections[index];
+            final Palette<BlockState> palette = section.getStates().data.palette();
+            final SectionWriter writer = new SectionWriter(section.getStates());
+            int emptied = 0;
+            boolean recount = false;
+
+            // the same writes in the same order as setting each block, so palette resizes match
+            if (carved != null) {
+                final BlockState air = Blocks.AIR.defaultBlockState();
+                for (int y = 0; y < 16; ++y) {
+                    for (int x = 1; x < 15; ++x) {
+                        for (int z = 1; z < 15; ++z) {
+                            final int pos = (y << 8) | (z << 4) | x;
+                            if (has(carved, pos)) {
+                                writer.set(pos, air);
+                                recount |= isCounted(palette.valueFor(sectionIds[pos]));
+                                ++emptied;
+                            }
+                        }
+                    }
+                }
+            }
+
+            if (ores != null && ores.any) {
+                for (int y = 0; y < 16; ++y) {
+                    for (int x = 0; x < 16; ++x) {
+                        for (int z = 0; z < 16; ++z) {
+                            final int pos = (y << 8) | (z << 4) | x;
+                            if (carved != null && has(carved, pos)) {
+                                continue;
+                            }
+
+                            final BlockState replacement = ores.forId(sectionIds[pos]);
+                            if (replacement != null) {
+                                writer.set(pos, replacement);
+                                recount |= isCounted(palette.valueFor(sectionIds[pos])) || isCounted(replacement);
+                            }
+                        }
+                    }
+                }
+            }
+
+            if (recount) {
+                section.recalcBlockCounts();
+            } else if (emptied != 0) {
+                section.canvas$emptiedPlainBlocks(emptied);
+            }
+        }
+    }
+
+    private static final class SectionWriter {
+        private final PalettedContainer<BlockState> states;
+        private PalettedContainer.Data<BlockState> data;
+        private final BlockState[] cachedStates = new BlockState[4];
+        private final int[] cachedIds = new int[4];
+        private int cached;
+
+        private SectionWriter(final PalettedContainer<BlockState> states) {
+            this.states = states;
+            this.data = states.data;
+        }
+
+        private void set(final int pos, final BlockState state) {
+            int id = -1;
+            for (int i = 0; i < this.cached; ++i) {
+                if (this.cachedStates[i] == state) {
+                    id = this.cachedIds[i];
+                    break;
+                }
+            }
+
+            if (id < 0) {
+                id = this.data.palette().idFor(state, this.states);
+                if (this.states.data != this.data) {
+                    // the palette was resized and renumbered
+                    this.data = this.states.data;
+                    this.cached = 0;
+                }
+                if (this.cached < this.cachedStates.length) {
+                    this.cachedStates[this.cached] = state;
+                    this.cachedIds[this.cached++] = id;
+                }
+            }
+
+            this.data.storage().set(pos, id);
+        }
+    }
+
+    private static long[] seeThroughMask(final Palette<BlockState> palette, final int[] sectionIds) {
+        final long[] mask = new long[MASK_LONGS];
+        if (palette instanceof GlobalPalette<BlockState>) {
+            for (int pos = 0; pos < MASK_SIZE; ++pos) {
+                if (palette.valueFor(sectionIds[pos]).isSeeThrough()) {
+                    mask[pos >>> 6] |= 1L << pos;
+                }
+            }
+            return mask;
+        }
+
+        final int paletteSize = palette.getSize();
+        final boolean[] seeThroughById = new boolean[paletteSize];
+        boolean any = false;
+        for (int id = 0; id < paletteSize; ++id) {
+            seeThroughById[id] = palette.valueFor(id).isSeeThrough();
+            any |= seeThroughById[id];
+        }
+
+        if (any) {
+            for (int pos = 0; pos < MASK_SIZE; ++pos) {
+                if (seeThroughById[sectionIds[pos]]) {
+                    mask[pos >>> 6] |= 1L << pos;
+                }
+            }
+        }
+        return mask;
+    }
+
+    private static long @Nullable [] carve(final long[] @Nullable [] seeThrough, final int index) {
+        final long[] mask = seeThrough[index];
+        final long[] below = index > 0 ? seeThrough[index - 1] : null;
+        final long[] above = index < seeThrough.length - 1 ? seeThrough[index + 1] : null;
+
+        long[] carved = null;
+        for (int y = 0; y < 16; ++y) {
+            for (int z = 1; z < 15; ++z) {
+                final int row = row(mask, y, z);
+                final int exposed = row | (row << 1) | (row >>> 1)
+                    | row(mask, y, z - 1) | row(mask, y, z + 1)
+                    | (y > 0 ? row(mask, y - 1, z) : row(below, 15, z))
+                    | (y < 15 ? row(mask, y + 1, z) : row(above, 0, z));
+                final int hidden = ~exposed & INNER_ROW;
+                if (hidden != 0) {
+                    if (carved == null) {
+                        carved = new long[MASK_LONGS];
+                    }
+                    final int rowStart = (y << 8) | (z << 4);
+                    carved[rowStart >>> 6] |= (long)hidden << rowStart;
+                }
+            }
+        }
+        return carved;
+    }
+
+    // a missing or all air neighbor section counts as see-through
+    private static int row(final long @Nullable [] mask, final int y, final int z) {
+        if (mask == null) {
+            return 0xFFFF;
+        }
+        final int rowStart = (y << 8) | (z << 4);
+        return (int)(mask[rowStart >>> 6] >>> rowStart) & 0xFFFF;
+    }
+
+    private static boolean isCounted(final BlockState state) {
+        return state.isAir()
+            || state.isRandomlyTicking()
+            || !state.getFluidState().isEmpty()
+            || ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.isSpecialCollidingBlock(state);
+    }
+
+    private static @Nullable BlockState oreReplacement(final BlockState state) {
+        if (state.isAir()) {
+            return null;
+        }
+
+        // checked first, nether gold ore is a gold ore too
+        if (state.is(Blocks.NETHER_GOLD_ORE) || state.is(Blocks.NETHER_QUARTZ_ORE) || state.is(Blocks.ANCIENT_DEBRIS)) {
+            return Blocks.NETHERRACK.defaultBlockState();
+        }
+
+        if (IS_ORE.test(state)) {
+            // is an ore, replace with the stone it sits in
+            return (IS_DEEPSLATE_ORE.test(state) ? Blocks.DEEPSLATE : Blocks.STONE).defaultBlockState();
+        }
+        return null;
+    }
+
+    private static final class OreReplacements {
+        private final Palette<BlockState> palette;
+        private final @Nullable BlockState @Nullable [] byId;
+        private final boolean any;
+
+        private OreReplacements(final Palette<BlockState> palette) {
+            this.palette = palette;
+            if (palette instanceof GlobalPalette<BlockState>) {
+                // too many ids to tabulate, so look each block up
+                this.byId = null;
+                this.any = true;
+                return;
+            }
+
+            final int paletteSize = palette.getSize();
+            final @Nullable BlockState[] byId = new BlockState[paletteSize];
+            boolean any = false;
+            for (int id = 0; id < paletteSize; ++id) {
+                byId[id] = oreReplacement(palette.valueFor(id));
+                any |= byId[id] != null;
+            }
+            this.byId = byId;
+            this.any = any;
+        }
+
+        private @Nullable BlockState forId(final int id) {
+            return this.byId != null ? this.byId[id] : oreReplacement(this.palette.valueFor(id));
+        }
+    }
+
+    public static ClientboundLightUpdatePacketData createLightData(
+        final SerializableChunkData data, final ServerLevel world
+    ) {
+        final LevelLightEngine lightEngine = world.getLightEngine();
+        final int minLightSection = lightEngine.getMinLightSection();
+        final int sectionCount = lightEngine.getLightSectionCount();
+        final boolean hasSkyLight = world.dimensionType().hasSkyLight();
+
+        final SerializableChunkData.@Nullable SectionData[] byY = new SerializableChunkData.SectionData[sectionCount];
+
+        if (data.lightCorrect()) {
+            for (final SerializableChunkData.SectionData section : data.sectionData()) {
+                final int idx = section.y() - minLightSection;
+                if (idx >= 0 && idx < sectionCount) byY[idx] = section;
+            }
+        }
+
+        final BitSet skyMask = new BitSet();
+        final BitSet blockMask = new BitSet();
+        final BitSet emptySkyMask = new BitSet();
+        final BitSet emptyBlockMask = new BitSet();
+
+        final ObjectArrayList<byte[]> skyUpdates = new ObjectArrayList<>();
+        final ObjectArrayList<byte[]> blockUpdates = new ObjectArrayList<>();
+
+        for (int lIdx = 0; lIdx < sectionCount; ++lIdx) {
+            final SerializableChunkData.SectionData stored = byY[lIdx];
+
+            recordLayer(
+                stored == null ? null : stored.blockLight(), stored == null ? -1 : stored.starlight$getBlockLightState(),
+                lIdx, blockMask, emptyBlockMask, blockUpdates
+            );
+
+            // only record skylight if the dimension HAS skylight
+            if (hasSkyLight) {
+                recordLayer(
+                    stored == null ? null : stored.skyLight(), stored == null ? -1 : stored.starlight$getSkyLightState(),
+                    lIdx, skyMask, emptySkyMask, skyUpdates
+                );
+            }
+        }
+
+        return new ClientboundLightUpdatePacketData(
+            skyMask,
+            blockMask,
+            emptySkyMask,
+            emptyBlockMask,
+            skyUpdates,
+            blockUpdates
+        );
+    }
+
+    private static void recordLayer(
+        @Nullable
+        final DataLayer layer,
+        final int state,
+        final int idx,
+        final BitSet mask,
+        final BitSet emptyMask,
+        final ObjectArrayList<byte[]> updates
+    ) {
+        // send what the live light engine would, the client lights an empty section from above
+        if (state < 0) {
+            return;
+        }
+
+        final DataLayer visible = new SWMRNibbleArray(layer == null ? null : layer.getData(), state).toVanillaNibble();
+        if (visible == null) {
+            return;
+        }
+
+        if (visible.isEmpty()) {
+            emptyMask.set(idx);
+        }
+        else {
+            mask.set(idx);
+            updates.add(visible.getData());
+        }
+    }
+
+    private static boolean has(final long[] mask, final int pos) {
+        return (mask[pos >>> 6] & (1L << pos)) != 0L;
+    }
+}
diff --git a/io/canvasmc/canvas/extendedview/Result.java b/io/canvasmc/canvas/extendedview/Result.java
new file mode 100644
index 0000000000000000000000000000000000000000..4467b34664a68a37c4f5904ced7532d9b4e117a5
--- /dev/null
+++ b/io/canvasmc/canvas/extendedview/Result.java
@@ -0,0 +1,81 @@
+package io.canvasmc.canvas.extendedview;
+
+import net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket;
+
+public sealed interface Result {
+    boolean isFailure();
+
+    boolean isNotGenerated();
+
+    boolean isSuccess();
+
+    ClientboundLevelChunkWithLightPacket getPacketOrThrow();
+
+    record Success(ClientboundLevelChunkWithLightPacket packet) implements Result {
+        @Override
+        public boolean isFailure() {
+            return false;
+        }
+
+        @Override
+        public boolean isNotGenerated() {
+            return false;
+        }
+
+        @Override
+        public boolean isSuccess() {
+            return true;
+        }
+
+        @Override
+        public ClientboundLevelChunkWithLightPacket getPacketOrThrow() {
+            return this.packet;
+        }
+    }
+
+    record NotGenerated() implements Result {
+        public static final NotGenerated INSTANCE = new NotGenerated();
+
+        @Override
+        public boolean isFailure() {
+            return false;
+        }
+
+        @Override
+        public boolean isNotGenerated() {
+            return true;
+        }
+
+        @Override
+        public boolean isSuccess() {
+            return false;
+        }
+
+        @Override
+        public ClientboundLevelChunkWithLightPacket getPacketOrThrow() {
+            throw new IllegalStateException("Chunk is not generated");
+        }
+    }
+
+    record Failure(Throwable cause) implements Result {
+        @Override
+        public boolean isFailure() {
+            return true;
+        }
+
+        @Override
+        public boolean isNotGenerated() {
+            return false;
+        }
+
+        @Override
+        public boolean isSuccess() {
+            return false;
+        }
+
+        @Override
+        public ClientboundLevelChunkWithLightPacket getPacketOrThrow() {
+            throw new IllegalStateException("Chunk failed to load", this.cause);
+        }
+    }
+}
diff --git a/io/canvasmc/canvas/extendedview/VVChunkCache.java b/io/canvasmc/canvas/extendedview/VVChunkCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..0db4a6a54e15e9f91f9c53cb66b1fe9ff05bd589
--- /dev/null
+++ b/io/canvasmc/canvas/extendedview/VVChunkCache.java
@@ -0,0 +1,49 @@
+package io.canvasmc.canvas.extendedview;
+
+import ca.spottedleaf.concurrentutil.map.concurrent.longs.ConcurrentChainedLong2ReferenceHashTable;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+
+public final class VVChunkCache {
+    private static final long REMOVE_DELAY_NANOS = TimeUnit.SECONDS.toNanos(5);
+    private static final int SWEEP_INTERVAL = 20;
+
+    private final ConcurrentChainedLong2ReferenceHashTable<Entry> cache = new ConcurrentChainedLong2ReferenceHashTable<>();
+
+    private int ticks;
+
+    public CompletableFuture<Result> computeIfAbsent(
+        final long chunkKey,
+        final ConcurrentChainedLong2ReferenceHashTable.BiLongObjectFunction<? extends CompletableFuture<Result>> builder
+    ) {
+        final Entry entry = this.cache.computeIfAbsent(chunkKey, (key) -> new Entry(builder.apply(key)));
+        entry.lastAccessNanos = System.nanoTime();
+        return entry.future;
+    }
+
+    public void tick() {
+        if (++this.ticks % SWEEP_INTERVAL != 0) {
+            return;
+        }
+
+        final long now = System.nanoTime();
+        for (final ConcurrentChainedLong2ReferenceHashTable.TableEntry<Entry> tableEntry : this.cache) {
+            final Entry entry = tableEntry.getValue();
+
+            // keep builds in flight, and anything a player asked for in the last few seconds
+            if (entry.future.isDone() && now - entry.lastAccessNanos > REMOVE_DELAY_NANOS) {
+                this.cache.remove(tableEntry.getKey(), entry);
+            }
+        }
+    }
+
+    private static final class Entry {
+        final CompletableFuture<Result> future;
+        volatile long lastAccessNanos;
+
+        Entry(final CompletableFuture<Result> future) {
+            this.future = future;
+            this.lastAccessNanos = System.nanoTime();
+        }
+    }
+}
