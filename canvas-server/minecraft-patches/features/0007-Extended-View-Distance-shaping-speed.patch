+    private static long @Nullable [] carve(final long[] @Nullable [] seeThrough, final int index) {
+        final long[] mask = seeThrough[index];
+        final long[] below = index > 0 ? seeThrough[index - 1] : null;
+        final long[] above = index < seeThrough.length - 1 ? seeThrough[index + 1] : null;
+
+        // one 16 block row along x at a time: a block is exposed when it or a neighbor is see-through
+        long[] carved = null;
+        for (int y = 0; y < 16; ++y) {
+            for (int z = 1; z < 15; ++z) {
+                final int row = row(mask, y, z);
+                final int exposed = row | (row << 1) | (row >>> 1)
+                    | row(mask, y, z - 1) | row(mask, y, z + 1)
+                    | (y > 0 ? row(mask, y - 1, z) : row(below, 15, z))
+                    | (y < 15 ? row(mask, y + 1, z) : row(above, 0, z));
+                final int hidden = ~exposed & INNER_ROW;
+                if (hidden != 0) {
+                    if (carved == null) {
+                        carved = new long[MASK_LONGS];
                     }
+                    final int rowStart = (y << 8) | (z << 4);
+                    carved[rowStart >>> 6] |= (long)hidden << rowStart;
                 }
             }
         }
+        return carved;
+    }
+
+    // a missing or all air neighbor section counts as see-through
+    private static int row(final long @Nullable [] mask, final int y, final int z) {
+        if (mask == null) {
+            return 0xFFFF;
+        }
+        final int rowStart = (y << 8) | (z << 4);
+        return (int)(mask[rowStart >>> 6] >>> rowStart) & 0xFFFF;
+    }
+
+    // a block the section counts as more than non-air: air, randomly ticking, holding fluid, or of special collision
+    private static boolean isCounted(final BlockState state) {
+        return state.isAir()
+            || state.isRandomlyTicking()
+            || !state.getFluidState().isEmpty()
+            || ca.spottedleaf.moonrise.patches.collisions.CollisionUtil.isSpecialCollidingBlock(state);
+    }
+
+    private static @Nullable BlockState oreReplacement(final BlockState state) {
+        if (state.isAir()) {
+            return null;
+        }
+
+        // checked first, since nether gold ore is a gold ore too: the nether's ores sit in its own stone
+        if (state.is(Blocks.NETHER_GOLD_ORE) || state.is(Blocks.NETHER_QUARTZ_ORE) || state.is(Blocks.ANCIENT_DEBRIS)) {
+            return Blocks.NETHERRACK.defaultBlockState();
+        }
+
+        if (IS_ORE.test(state)) {
+            // is an ore, replace with the stone it sits in
+            return (IS_DEEPSLATE_ORE.test(state) ? Blocks.DEEPSLATE : Blocks.STONE).defaultBlockState();
+        }
+        return null;
+    }
+
+    private static final class OreReplacements {
+        private final Palette<BlockState> palette;
+        private final @Nullable BlockState @Nullable [] byId;
+        private final boolean any;
+
+        private OreReplacements(final Palette<BlockState> palette) {
+            this.palette = palette;
+            if (palette instanceof GlobalPalette<BlockState>) {
+                // too many ids to tabulate, so look each block up
+                this.byId = null;
+                this.any = true;
+                return;
+            }
+
+            final int paletteSize = palette.getSize();
+            final @Nullable BlockState[] byId = new BlockState[paletteSize];
+            boolean any = false;
+            for (int id = 0; id < paletteSize; ++id) {
+                any |= (byId[id] = oreReplacement(palette.valueFor(id))) != null;
+            }
+            this.byId = byId;
+            this.any = any;
+        }
+
+        private @Nullable BlockState forId(final int id) {
+            return this.byId != null ? this.byId[id] : oreReplacement(this.palette.valueFor(id));
+        }
     }
 
