Subject: [PATCH] Permission Resolver


diff --git a/src/main/java/org/bukkit/permissions/PermissibleBase.java b/src/main/java/org/bukkit/permissions/PermissibleBase.java
index 75b77cc4fe189b4b6baa1af3663dc492e992a266..c5369ac4386a006e5af2872be5afafc3a59e3bed 100644
--- a/src/main/java/org/bukkit/permissions/PermissibleBase.java
+++ b/src/main/java/org/bukkit/permissions/PermissibleBase.java
@@ -106,6 +106,23 @@ public class PermissibleBase implements Permissible {
         return perm.getDefault().getValue(isOp());
     }
 
+    // Canvas start - permission resolver
+    /**
+     * Gets the value a plugin's {@link PermissionAttachment} gives a permission, directly or as a child of one it
+     * sets, ignoring the default permissions.
+     *
+     * @param name the permission's name
+     * @return the attachment's value, or null when no attachment sets the permission
+     */
+    @Nullable
+    @org.jetbrains.annotations.ApiStatus.Internal
+    public PermissionAttachmentInfo getAttachedPermission(@NotNull String name) {
+        PermissionAttachmentInfo info = permissions.get(name.toLowerCase(Locale.ROOT));
+
+        return info == null || info.getAttachment() == null ? null : info;
+    }
+    // Canvas end - permission resolver
+
     @Override
     @NotNull
     public synchronized PermissionAttachment addAttachment(@NotNull Plugin plugin, @NotNull String name, boolean value) { // Paper - synchronized
